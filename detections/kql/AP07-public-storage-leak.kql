//     | where account_name == "" or AccountName =~ account_name
//     | where AuthenticationType =~ "Anonymous" and OperationName in~ ("GetBlob", "GetBlobProperties")
//     | where Uri has leaked_blob or ObjectKey has leaked_blob
//     | extend ClientIp = tostring(split(CallerIpAddress, ":")[0])
//     | project GetTime = TimeGenerated, ClientIp, GetUri = Uri;
// let cred_get =
//     StorageBlobLogs
//     | where TimeGenerated > ago(lookback)
//     | where account_name == "" or AccountName =~ account_name
//     | where AuthenticationType in~ (shared_key_auth)
//     | where Uri has private_container or ObjectKey has private_container
//     | extend ClientIp = tostring(split(CallerIpAddress, ":")[0])
//     | project PivotTime = TimeGenerated, ClientIp, PivotAuth = AuthenticationType, PivotUri = Uri;
// anon_get
// | join kind=inner cred_get on ClientIp
// | where PivotTime between (GetTime .. (GetTime + corr_window))
// // NUCLEO (alta fidelidad): anon-get(backup-config.json) -> cred-get(sensitive-data) desde la
// // MISMA IP dentro de corr_window. NUNCA se descarta: es el pivote que la remediacion mata.
// | join kind=leftouter anon_list on ClientIp
// // La lista previa (ListBlobs) es OPCIONAL -> se ANOTA, NO se filtra. Un ListBlobs de la MISMA
// // IP FUERA de ventana (o ausente) NO debe tirar el nucleo. El leftouter puede multiplicar la
// // fila por cada ListBlobs -> se colapsa con summarize por la identidad del nucleo.
// | extend ListedInWindow = isnotempty(ListUri) and ListTime between (GetTime - corr_window .. GetTime)
// | summarize ListTime = maxif(ListTime, ListedInWindow),
//             ListUri  = take_anyif(ListUri, ListedInWindow),
//             InWindowListCount = countif(ListedInWindow)
//         by ClientIp, GetTime, GetUri, PivotTime, PivotAuth, PivotUri
// | extend PrecededByList = InWindowListCount > 0
// | project ClientIp, PrecededByList, ListTime, ListUri, GetTime, GetUri, PivotTime, PivotAuth, PivotUri,
//           Alerta = "AP07: anonymous-get(backup-config.json) -> SAS/Key-get(sensitive-data) desde la MISMA IP = cadena public->private (PrecededByList=true si hubo ListBlobs anonimo previo en ventana)"
// | sort by GetTime asc


// ---------------------------------------------------------------------
// COMPLEMENTO (plano de gestion, alta fidelidad) - listKeys sobre la cuenta AP07 por un
// principal INESPERADO = recuperacion de la clave de control total (leak_mode=account_key
// o robo de clave). Acotar por Caller a una allowlist de automatizacion/IaC conocida
// convierte esto en una regla de baja FP (el propio Terraform del lab hace listKeys al
// desplegar). Descomentar y rellenar la allowlist.
// ---------------------------------------------------------------------
// let known_automation = dynamic([]);   // objectIds / UPNs de IaC/operadores esperados
// AzureActivity
// | where TimeGenerated > ago(lookback)
// | where OperationNameValue =~ "MICROSOFT.STORAGE/STORAGEACCOUNTS/LISTKEYS/ACTION"
// | where ActivityStatusValue in~ ("Success", "Accept", "Start")
// | where account_name == "" or _ResourceId has account_name
// | where Caller !in~ (known_automation)
// | project TimeGenerated, Caller, CallerIpAddress, _ResourceId,
//           Alerta = "AP07: listKeys sobre la cuenta por principal no allowlisted (recuperacion de shared key)"
// | sort by TimeGenerated asc
