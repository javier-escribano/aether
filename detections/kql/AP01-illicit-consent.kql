// =====================================================================
// AP01 — Illicit consent grant -> high-value Graph scopes
// Source: Entra ID Audit Logs (AuditLogs table in Sentinel / Defender XDR)
// MITRE: T1528, T1098.003
// =====================================================================
AuditLogs
| where OperationName in ("Consent to application", "Add delegated permission grant")
| extend TargetApp   = tostring(TargetResources[0].displayName)
| extend Initiator   = coalesce(
                          tostring(InitiatedBy.user.userPrincipalName),
                          tostring(InitiatedBy.app.displayName))
| extend IpAddress   = tostring(InitiatedBy.user.ipAddress)
// Extract the consented scopes from ModifiedProperties
| mv-apply Prop = ModifiedProperties on (
      where tostring(Prop.displayName) in ("ConsentAction.Permissions", "DelegatedPermissionGrant.Scope")
    | extend ConsentedScopes = tostring(Prop.newValue)
  )
| where ConsentedScopes has_any (
      "Mail.Read", "Mail.ReadWrite", "Mail.Send",
      "Files.Read.All", "Files.ReadWrite.All",
      "offline_access", "User.Read.All", "Directory.Read.All")
| project TimeGenerated, OperationName, Initiator, IpAddress, TargetApp, ConsentedScopes, Result
| sort by TimeGenerated desc
