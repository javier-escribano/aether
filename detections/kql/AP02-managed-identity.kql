// =====================================================================
// AP02 — Managed Identity sobre-privilegiada -> self-grant en Key Vault ->
//        robo del secreto botin -> movimiento lateral (VM -> MI -> KV -> SP -> datos)
//
// Fuentes (tablas REALES en Log Analytics / Sentinel / Defender XDR):
//   - AzureActivity            (management-plane: role assignment + set-policy / update vault)
//   - AzureDiagnostics         (data-plane Key Vault, ResourceType == 'VAULTS')  [modo clasico]
//   - AZKVAuditLogs            (data-plane Key Vault, tabla dedicada)            [modo resource-specific]
//
// MITRE: T1098  (Account Manipulation: self-grant via access policy)
//        T1552.005 (Unsecured Credentials: Cloud Instance Metadata API -> lectura del secreto)
//        T1078.004 (Valid Accounts: Cloud Accounts — MI sobre-privilegiada y SP robado)
//        T1580  (Cloud Infrastructure Discovery — enumeracion previa, no cubierta aqui)
//
// CAVEAT: la llamada al IMDS (169.254.169.254) NO genera telemetria propia en Azure.
// La deteccion se apoya en eventos AGUAS ABAJO: AzureActivity del set-policy/role
// assignment y AuditEvent del vault (SecretGet). No existe un "log de robo de token".
//
// Autor: Caelum Range   Fecha: 2026-11-14
// =====================================================================

let lab_prefix   = "caelum-ap02";                 // ajustar si cambia lab_prefix
let secret_name  = "automation-sp-secret";        // secreto botin (client secret del SP)
let lookback     = 1d;
let corr_window  = 30m;

// ---------------------------------------------------------------------
// SEÑAL A — Etapa 5 (T1098): la MI se auto-concede permiso de datos
//           reescribiendo la access policy del Key Vault (set-policy),
//           o se asigna un rol RBAC. Primitiva del temario CARTP.
//   az keyvault set-policy  -> Microsoft.KeyVault/vaults/accessPolicies/write
//                              (o Microsoft.KeyVault/vaults/write — "Update Key Vault")
//   role assignment         -> Microsoft.Authorization/roleAssignments/write
// ---------------------------------------------------------------------
let SignalA_mgmt =
    AzureActivity
    | where TimeGenerated > ago(lookback)
    | where OperationNameValue in~ (
          "MICROSOFT.KEYVAULT/VAULTS/ACCESSPOLICIES/WRITE",   // set-policy (self-grant)
          "MICROSOFT.KEYVAULT/VAULTS/WRITE",                  // update vault (puede llevar policy)
          "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE")    // asignacion de rol excesiva
    | where ActivityStatusValue in~ ("Success", "Accept", "Start")   // valores reales del esquema moderno de AzureActivity
    | extend Stage = case(
          OperationNameValue has "ROLEASSIGNMENTS", "T1098 — role assignment (priv. excesivo)",
          "T1098 — Key Vault access policy self-grant")
    | extend CallerRole = tostring(Authorization_d.evidence.role)   // rol RBAC del LLAMANTE (no el rol asignado en roleAssignments/write)
    | project TimeGenerated,
              Signal = "A-mgmt-plane",
              Stage,
              OperationNameValue,
              Caller,                      // objectId del principal que actua (MI / usuario)
              CallerIpAddress,
              ResourceGroup,
              _ResourceId,
              CallerRole,
              ActivityStatusValue;

// ---------------------------------------------------------------------
// SEÑAL B — Etapa 6 (T1552.005): lectura del secreto botin en el Key Vault
//           tras el self-grant. Modo CLASICO (AzureDiagnostics).
//           OperationName: SecretGet / SecretList.
//           identity_claim_oid_g = objectId del caller (principalId de la MI).
// ---------------------------------------------------------------------
let SignalB_diag =
    AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where ResourceType == "VAULTS"
    | where OperationName in~ ("SecretGet", "SecretList")
    | where ResultType =~ "Success" or ResultSignature =~ "OK"
    // filtra al secreto botin por la URI del request (…/secrets/automation-sp-secret/…)
    | where OperationName == "SecretList" or requestUri_s has secret_name
    | project TimeGenerated,
              Signal = "B-data-plane",
              Stage = "T1552.005 — exfil secreto (SecretGet)",
              OperationName,
              Caller = identity_claim_oid_g,     // objectId del caller == principalId MI
              CallerIpAddress = CallerIPAddress,
              VaultName = Resource,
              requestUri_s,
              ResultType;

// ---------------------------------------------------------------------
// SEÑAL B' — igual que B pero en tabla dedicada AZKVAuditLogs
//           (modo resource-specific de los diagnostic settings).
//           Descomentar si el vault emite a esta tabla en lugar de AzureDiagnostics.
// ---------------------------------------------------------------------
// let SignalB_kvaudit =
//     AZKVAuditLogs
//     | where TimeGenerated > ago(lookback)
//     | where OperationName in~ ("SecretGet", "SecretList")
//     | where ResultType =~ "Success"
//     | where OperationName == "SecretList" or id_s has secret_name
//     | project TimeGenerated,
//               Signal = "B-data-plane",
//               Stage = "T1552.005 — exfil secreto (SecretGet)",
//               OperationName,
//               Caller = identity_claim_oid_g,
//               CallerIpAddress = CallerIPAddress,   // en AZKVAuditLogs la IP es CallerIPAddress (IP en mayusculas)
//               VaultName = tostring(split(_ResourceId, "/")[-1]),
//               requestUri_s = id_s,
//               ResultType;

// =====================================================================
// SALIDA 1 — Timeline unificado de todas las señales AP02.
// Triage: una fila SEÑAL A (self-grant) seguida de B (SecretGet) por el
// mismo Caller en minutos ES la cadena AP02 completa.
// =====================================================================
union isfuzzy=true SignalA_mgmt, SignalB_diag
| sort by TimeGenerated asc

// =====================================================================
// SALIDA 2 (alta fidelidad) — Correlacion self-grant -> SecretGet por el
// MISMO principal dentro de corr_window. Casi cero falsos positivos:
// es exactamente el pivote que la remediacion (RBAC / menor privilegio)
// debe hacer imposible. Descomentar para usar como regla de alerta.
// =====================================================================
// SignalA_mgmt
// | where OperationNameValue has "KEYVAULT"            // solo el self-grant sobre el vault
// | project GrantTime = TimeGenerated, Principal = Caller, GrantIp = CallerIpAddress, OperationNameValue
// | join kind=inner (
//     SignalB_diag
//     | project ReadTime = TimeGenerated, Principal = Caller, ReadIp = CallerIpAddress, OperationName, requestUri_s
//   ) on Principal
// | where ReadTime between (GrantTime .. (GrantTime + corr_window))
// | project Principal, GrantTime, OperationNameValue, ReadTime, OperationName, requestUri_s, GrantIp, ReadIp
// | sort by ReadTime asc
