// =====================================================================
// AP02 — Over-privileged Managed Identity -> self-grant on Key Vault ->
//        theft of the loot secret -> lateral movement (VM -> MI -> KV -> SP -> data)
//
// Sources (REAL tables in Log Analytics / Sentinel / Defender XDR):
//   - AzureActivity            (management-plane: role assignment + set-policy / update vault)
//   - AzureDiagnostics         (data-plane Key Vault, ResourceType == 'VAULTS')  [classic mode]
//   - AZKVAuditLogs            (data-plane Key Vault, dedicated table)            [resource-specific mode]
//
// MITRE: T1098  (Account Manipulation: self-grant via access policy)
//        T1552.005 (Unsecured Credentials: Cloud Instance Metadata API -> reading the secret)
//        T1078.004 (Valid Accounts: Cloud Accounts — over-privileged MI and stolen SP)
//        T1580  (Cloud Infrastructure Discovery — prior enumeration, not covered here)
//
// CAVEAT: the call to IMDS (169.254.169.254) does NOT generate its own telemetry in Azure.
// Detection relies on DOWNSTREAM events: AzureActivity for the set-policy / role
// assignment and the vault's AuditEvent (SecretGet). There is no "token theft log".
//
// Author: AETHER   Date: 2026-11-14
// =====================================================================

let lab_prefix   = "aether-ap02";                // adjust if lab_prefix changes
let secret_name  = "automation-sp-secret";        // loot secret (client secret of the SP)
let lookback     = 1d;
let corr_window  = 30m;

// ---------------------------------------------------------------------
// SIGNAL A — Stage 5 (T1098): the MI self-grants data permission by
//           rewriting the Key Vault access policy (set-policy),
//           or assigns itself an RBAC role. CARTP-syllabus primitive.
//   az keyvault set-policy  -> Microsoft.KeyVault/vaults/accessPolicies/write
//                              (or Microsoft.KeyVault/vaults/write — "Update Key Vault")
//   role assignment         -> Microsoft.Authorization/roleAssignments/write
// ---------------------------------------------------------------------
let SignalA_mgmt =
    AzureActivity
    | where TimeGenerated > ago(lookback)
    | where OperationNameValue in~ (
          "MICROSOFT.KEYVAULT/VAULTS/ACCESSPOLICIES/WRITE",   // set-policy (self-grant)
          "MICROSOFT.KEYVAULT/VAULTS/WRITE",                  // update vault (may carry a policy)
          "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE")    // excessive role assignment
    | where ActivityStatusValue in~ ("Success", "Accept", "Start")   // real values of the modern AzureActivity schema
    | extend Stage = case(
          OperationNameValue has "ROLEASSIGNMENTS", "T1098 — role assignment (excessive priv.)",
          "T1098 — Key Vault access policy self-grant")
    | extend CallerRole = tostring(Authorization_d.evidence.role)   // RBAC role of the CALLER (not the role assigned in roleAssignments/write)
    | project TimeGenerated,
              Signal = "A-mgmt-plane",
              Stage,
              OperationNameValue,
              Caller,                      // objectId of the acting principal (MI / user)
              CallerIpAddress,
              ResourceGroup,
              _ResourceId,
              CallerRole,
              ActivityStatusValue;

// ---------------------------------------------------------------------
// SIGNAL B — Stage 6 (T1552.005): reading the loot secret in the Key Vault
//           after the self-grant. CLASSIC mode (AzureDiagnostics).
//           OperationName: SecretGet / SecretList.
//           identity_claim_oid_g = objectId of the caller (principalId of the MI).
// ---------------------------------------------------------------------
let SignalB_diag =
    AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where ResourceType == "VAULTS"
    | where OperationName in~ ("SecretGet", "SecretList")
    | where ResultType =~ "Success" or ResultSignature =~ "OK"
    // filter to the loot secret by the request URI (…/secrets/automation-sp-secret/…)
    | where OperationName == "SecretList" or requestUri_s has secret_name
    | project TimeGenerated,
              Signal = "B-data-plane",
              Stage = "T1552.005 — secret exfil (SecretGet)",
              OperationName,
              Caller = identity_claim_oid_g,     // objectId of the caller == principalId of the MI
              CallerIpAddress = CallerIPAddress,
              VaultName = Resource,
              requestUri_s,
              ResultType;

// ---------------------------------------------------------------------
// SIGNAL B' — same as B but in the dedicated AZKVAuditLogs table
//           (resource-specific mode of the diagnostic settings).
//           Uncomment if the vault emits to this table instead of AzureDiagnostics.
// ---------------------------------------------------------------------
// let SignalB_kvaudit =
//     AZKVAuditLogs
//     | where TimeGenerated > ago(lookback)
//     | where OperationName in~ ("SecretGet", "SecretList")
//     | where ResultType =~ "Success"
//     | where OperationName == "SecretList" or id_s has secret_name
//     | project TimeGenerated,
//               Signal = "B-data-plane",
//               Stage = "T1552.005 — secret exfil (SecretGet)",
//               OperationName,
//               Caller = identity_claim_oid_g,
//               CallerIpAddress = CallerIPAddress,   // in AZKVAuditLogs the IP is CallerIPAddress (IP uppercased)
//               VaultName = tostring(split(_ResourceId, "/")[-1]),
//               requestUri_s = id_s,
//               ResultType;

// =====================================================================
// OUTPUT 1 — Unified timeline of all AP02 signals.
// Triage: a SIGNAL A row (self-grant) followed by B (SecretGet) by the
// same Caller within minutes IS the full AP02 chain.
// =====================================================================
union isfuzzy=true SignalA_mgmt, SignalB_diag
| sort by TimeGenerated asc

// =====================================================================
// OUTPUT 2 (high fidelity) — Correlate self-grant -> SecretGet by the
// SAME principal within corr_window. Near-zero false positives:
// it is exactly the pivot that remediation (RBAC / least privilege)
// must make impossible. Uncomment to use as an alert rule.
// =====================================================================
// SignalA_mgmt
// | where OperationNameValue has "KEYVAULT"            // only the self-grant on the vault
// | project GrantTime = TimeGenerated, Principal = Caller, GrantIp = CallerIpAddress, OperationNameValue
// | join kind=inner (
//     SignalB_diag
//     | project ReadTime = TimeGenerated, Principal = Caller, ReadIp = CallerIpAddress, OperationName, requestUri_s
//   ) on Principal
// | where ReadTime between (GrantTime .. (GrantTime + corr_window))
// | project Principal, GrantTime, OperationNameValue, ReadTime, OperationName, requestUri_s, GrantIp, ReadIp
// | sort by ReadTime asc
