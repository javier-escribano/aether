// cred_adds
// | join kind=inner ga_grants on $left.AppName == $right.SpName
// | where GaTime between (CredTime .. (CredTime + 1h))
// | project CredTime, OwnerUser, AppName, GaTime, SpName, SpId,
//           Alert="AP04 full chain: owner adds cred -> SP self-assigns Global Admin"
// | sort by CredTime desc
