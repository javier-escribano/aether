// =====================================================================
// AETHER - AP04 : App Registration credential abuse and
//                             Service Principal persistence
// -----------------------------------------------------------------
//   AP id   : AP04
//   Table   : AuditLogs            (Microsoft Entra ID / Azure AD)
//   MITRE   : T1098.001 (Additional Cloud Credentials)  [CORE]
//             T1098.003 (Additional Cloud Roles)
//             T1078.004 (Valid Accounts: Cloud Accounts)
//             T1098     (Account Manipulation - Add owner to application)
//             T1087.004 (Account Discovery: Cloud Account)
// -----------------------------------------------------------------
//   CHAIN:  a LOW-privilege owner over an App Registration whose SP
//   carries a TIER-0 Microsoft Graph app role (admin-consented, e.g.
//   RoleManagement.ReadWrite.Directory = 9e3f62cf-ca93-4989-b6ce-bf83c28f9fe8)
//   -> the owner ADDS a client secret/cert (Entra default; THIS is what is
//      exploitable, it is not seeded) -> authenticates as the SP
//      (OAuth2 client_credentials) -> with the app role SELF-ASSIGNS
//      Global Administrator (roleTemplateId 62e90394-69f5-4237-9190-012177145e10).
//   Microsoft Graph resource app id = 00000003-0000-0000-c000-000000000000.
// =====================================================================


// ---------------------------------------------------------------------
// [A] STAGE 2 - T1098.001  (CORE SIGNAL)
//     Adding a credential (secret/cert) to an App Registration or its SP,
//     INITIATED BY A USER (the owner). If the initiator is a low-privilege
//     user (not an expected app admin) == owner backdoor.
//
//     OperationName-first DESIGN (NO AND-gate on modifiedProperties):
//     adding a credential DIRECTLY on a SERVICE PRINCIPAL
//     ('Add service principal credentials') does not always materialize a
//     'KeyDescription' modifiedProperty (nor even a non-empty
//     modifiedProperties); requiring that property -or an mv-expand over it- as a
//     mandatory filter would DISCARD precisely the SP-backdoor branch. That is
//     why the credential material is EXTRACTED as ENRICHMENT (tolerant string
//     search over the blob), it never gates the row. Aligned with the canonical
//     Microsoft Sentinel rule NRT_NewAppOrServicePrincipalCredential
//     (keys on OperationName has_any 'Add service principal credentials' /
//     'Certificates and secrets management').
// ---------------------------------------------------------------------
let credential_add_ops = dynamic([
    "Add service principal credentials",
    "Update application - Certificates and secrets management",
    "Update application – Certificates and secrets management",  // en-dash variant = the real portal form
    "Update application",
    "Update service principal"
]);
AuditLogs
| where OperationName in (credential_add_ops)
| extend InitiatedByUser = tostring(InitiatedBy.user.userPrincipalName)
| extend InitiatedById   = tostring(InitiatedBy.user.id)
| extend InitiatedByIp   = tostring(InitiatedBy.user.ipAddress)
// the initiator is an interactive user (owner), not the pipeline/MS that manages the app
| where isnotempty(InitiatedByUser)
// --- enrichment (NOT a filter): affected object + hint of credential material ---
| extend TargetObjectType = tostring(TargetResources[0].type)      // 'Application' or 'ServicePrincipal'
| extend TargetObjectName = tostring(TargetResources[0].displayName)
| extend TargetObjectId   = tostring(TargetResources[0].id)
| extend ModifiedProps    = TargetResources[0].modifiedProperties
// 'KeyDescription' is the REAL displayName of the modifiedProperty carrying the
// credential material in Entra AuditLogs; 'KeyCredentials'/'PasswordCredentials'
// remain as a defensive fallback. It is a hint (string search over the blob) that
// does NOT discard the row: the 'Add service principal credentials' branch is kept
// even if it does not expose that property.
| extend CredMaterialPresent = tostring(ModifiedProps) has_any ("KeyDescription", "KeyCredentials", "PasswordCredentials")
| project
    TimeGenerated,
    Stage      = "2-credential added (T1098.001)",
    OperationName,
    InitiatedByUser,
    InitiatedById,
    InitiatedByIp,
    TargetObjectType,
    TargetObjectName,
    TargetObjectId,
    CredMaterialPresent,
    ModifiedProps,
    Result,
    CorrelationId
| sort by TimeGenerated desc


// =====================================================================
// Supporting queries (run separately). Each block = one stage.
// =====================================================================

// ---------------------------------------------------------------------
// [B] PRECONDITION / STAGE 0 - admin-consent of the dangerous app role
//     "Add app role assignment to service principal" == granting an
//     APPLICATION permission of Graph to the SP. Alert if the appRoleId is
//     tier-0 (guarantees or eases escalation to Global Admin).
//     T1098.003 / precondition of AP04.
// ---------------------------------------------------------------------
// let tier0_app_roles = dynamic([
//     "9e3f62cf-ca93-4989-b6ce-bf83c28f9fe8",   // RoleManagement.ReadWrite.Directory (-> GA guaranteed)
//     "06b708a9-e830-4db3-a914-8e69da51d44f",   // AppRoleAssignment.ReadWrite.All     (-> GA guaranteed)
//     "1bfefb4e-e0b5-418b-a88f-73c46d2cc8e9"    // Application.ReadWrite.All           (credential persistence)
// ]);
// AuditLogs
// | where OperationName == "Add app role assignment to service principal"
// | extend InitiatedByUser = tostring(InitiatedBy.user.userPrincipalName)
// | mv-expand TargetResource = TargetResources
// | mv-expand ModProp = TargetResource.modifiedProperties
// | extend ModPropName = tostring(ModProp.displayName)
// | extend AppRoleId   = tostring(trim('"', tostring(ModProp.newValue)))
// | where ModPropName == "AppRoleId" and AppRoleId in (tier0_app_roles)
// | project TimeGenerated, Stage="0-admin consent app role tier-0", OperationName,
//           InitiatedByUser, SP=tostring(TargetResource.displayName), AppRoleId, Result, CorrelationId
// | sort by TimeGenerated desc


// ---------------------------------------------------------------------
// [C] STAGE 4 - T1098.003 / T1078.004  (HIGH PRIORITY)
//     Assignment of a privileged DIRECTORY ROLE (Global Administrator
//     / Privileged Role Administrator) whose INITIATOR is a SERVICE
//     PRINCIPAL (app-only), not an interactive admin. This is the signature of the
//     self-grant after authenticating as the SP with the added secret.
//     The role name lives in modifiedProperties (displayName=='Role.DisplayName'),
//     NOT in TargetResources[0].displayName (that is the destination PRINCIPAL).
// ---------------------------------------------------------------------
// let privileged_roles = dynamic(["Global Administrator", "Privileged Role Administrator"]);
// AuditLogs
// | where OperationName in ("Add member to role", "Add eligible member to role")
// | extend InitiatorApp = tostring(InitiatedBy.app.displayName)
// | extend InitiatorSpId = tostring(InitiatedBy.app.servicePrincipalId)
// | where isnotempty(InitiatorSpId)                      // initiated by an SP, not by a user
// | mv-expand TargetResource = TargetResources
// | mv-expand ModProp = TargetResource.modifiedProperties
// | extend ModPropName = tostring(ModProp.displayName)
// | extend RoleName = tostring(trim('"', tostring(ModProp.newValue)))
// | where ModPropName == "Role.DisplayName" and RoleName in (privileged_roles)
// | project TimeGenerated, Stage="4-role self-grant by SP (T1098.003)", OperationName,
//           InitiatorApp, InitiatorSpId, AssignedRole=RoleName,
//           DestinationPrincipal=tostring(TargetResource.userPrincipalName), Result, CorrelationId
// | sort by TimeGenerated desc


// ---------------------------------------------------------------------
// [D] PERSISTENCE / PRECONDITION - T1098  "Add owner to application"
//     Adding a (low-privilege) owner to an app/SP. This is both the
//     precondition of AP04 and a persistence avenue (adding oneself as owner of
//     another app after reaching GA).
// ---------------------------------------------------------------------
// AuditLogs
// | where OperationName in ("Add owner to application", "Add owner to service principal")
// | extend InitiatedByUser = tostring(InitiatedBy.user.userPrincipalName)
// | mv-expand TargetResource = TargetResources
// | project TimeGenerated, Stage="persistence/precondition-add owner (T1098)", OperationName,
//           InitiatedByUser, Object=tostring(TargetResource.displayName),
//           ObjectType=tostring(TargetResource.type), Result, CorrelationId
// | sort by TimeGenerated desc


// ---------------------------------------------------------------------
// [E] CORRELATION - full AP04 chain within a 1h window
//     owner (user U) adds a credential to the app  ==>  an SP self-assigns
//     Global Administrator shortly after. Cross [A] with [C] by time.
//     Minimizes false positives: fires only when both stages coexist.
// ---------------------------------------------------------------------
