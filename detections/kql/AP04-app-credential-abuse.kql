// | where OperationName == "Add app role assignment to service principal"
// | extend InitiatedByUser = tostring(InitiatedBy.user.userPrincipalName)
// | mv-expand TargetResource = TargetResources
// | mv-expand ModProp = TargetResource.modifiedProperties
// | extend ModPropName = tostring(ModProp.displayName)
// | extend AppRoleId   = tostring(trim('"', tostring(ModProp.newValue)))
// | where ModPropName == "AppRoleId" and AppRoleId in (tier0_app_roles)
// | project TimeGenerated, Etapa="0-admin consent app role tier-0", OperationName,
//           InitiatedByUser, SP=tostring(TargetResource.displayName), AppRoleId, Result, CorrelationId
// | sort by TimeGenerated desc


// ---------------------------------------------------------------------
// [C] ETAPA 4 - T1098.003 / T1078.004  (ALTA PRIORIDAD)
//     Asignacion de un ROL DE DIRECTORIO privilegiado (Global Administrator
//     / Privileged Role Administrator) cuyo INICIADOR es un SERVICE
//     PRINCIPAL (app-only), no un admin interactivo. Es la firma del
//     self-grant tras autenticarse como el SP con el secret anadido.
//     El nombre del rol vive en modifiedProperties (displayName=='Role.DisplayName'),
//     NO en TargetResources[0].displayName (eso es el PRINCIPAL destino).
// ---------------------------------------------------------------------
