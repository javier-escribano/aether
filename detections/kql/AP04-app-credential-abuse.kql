//           InitiatorApp, InitiatorSpId, RolAsignado=RoleName,
//           PrincipalDestino=tostring(TargetResource.userPrincipalName), Result, CorrelationId
// | sort by TimeGenerated desc


// ---------------------------------------------------------------------
// [D] PERSISTENCIA / PRECONDICION - T1098  "Add owner to application"
//     Alta de un owner (de bajo privilegio) sobre una app/SP. Es tanto la
//     precondicion de AP04 como una via de persistencia (anadirse owner de
//     otra app tras llegar a GA).
// ---------------------------------------------------------------------
// AuditLogs
// | where OperationName in ("Add owner to application", "Add owner to service principal")
// | extend InitiatedByUser = tostring(InitiatedBy.user.userPrincipalName)
// | mv-expand TargetResource = TargetResources
// | project TimeGenerated, Etapa="persistencia/precondicion-add owner (T1098)", OperationName,
//           InitiatedByUser, Objeto=tostring(TargetResource.displayName),
//           ObjetoTipo=tostring(TargetResource.type), Result, CorrelationId
// | sort by TimeGenerated desc


// ---------------------------------------------------------------------
// [E] CORRELACION - cadena completa AP04 en ventana de 1h
//     owner (usuario U) anade credencial a la app  ==>  un SP se auto-asigna
//     Global Administrator poco despues. Cruza [A] con [C] por tiempo.
//     Minimiza falsos positivos: dispara solo cuando ambas etapas coexisten.
// ---------------------------------------------------------------------
