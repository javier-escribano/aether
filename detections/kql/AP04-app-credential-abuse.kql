// =====================================================================
// Caelum Range - AP04 : Abuso de credenciales de App Registration y
//                       persistencia de Service Principal
// -----------------------------------------------------------------
//   AP id   : AP04
//   Tabla   : AuditLogs            (Microsoft Entra ID / Azure AD)
//   MITRE   : T1098.001 (Additional Cloud Credentials)  [NUCLEO]
//             T1098.003 (Additional Cloud Roles)
//             T1078.004 (Valid Accounts: Cloud Accounts)
//             T1098     (Account Manipulation - Add owner to application)
//             T1087.004 (Account Discovery: Cloud Account)
// -----------------------------------------------------------------
//   CADENA:  owner de BAJO privilegio sobre una App Registration cuyo SP
//   porta un app role TIER-0 de Microsoft Graph (admin-consented, p.ej.
//   RoleManagement.ReadWrite.Directory = 9e3f62cf-ca93-4989-b6ce-bf83c28f9fe8)
//   -> el owner ANADE un client secret/cert (default de Entra; ESTO es lo
//      explotable, no se siembra) -> se autentica como el SP
//      (OAuth2 client_credentials) -> con el app role se AUTO-ASIGNA
//      Global Administrator (roleTemplateId 62e90394-69f5-4237-9190-012177145e10).
//   Microsoft Graph resource app id = 00000003-0000-0000-c000-000000000000.
// =====================================================================


// ---------------------------------------------------------------------
// [A] ETAPA 2 - T1098.001  (SENAL NUCLEO)
//     Alta de credencial (secret/cert) sobre una App Registration o su SP,
//     INICIADA POR UN USUARIO (el owner). Si el iniciador es un usuario de
//     bajo privilegio (no un admin de apps esperado) == backdoor de owner.
//
//     DISENO OperationName-first (NO AND-gate sobre modifiedProperties):
//     el alta de credencial DIRECTA sobre un SERVICE PRINCIPAL
//     ('Add service principal credentials') no siempre materializa una
//     modifiedProperty 'KeyDescription' (ni siquiera un modifiedProperties
//     no vacio); exigir esa propiedad -o un mv-expand sobre ella- como
//     filtro obligatorio DESCARTABA justo la rama de backdoor de SP. Por
//     eso el material de credencial se EXTRAE como ENRIQUECIMIENTO (string
//     search tolerante sobre el blob), nunca gatea la fila. Alineado con la
//     regla canonica de Microsoft Sentinel NRT_NewAppOrServicePrincipalCredential
//     (keys on OperationName has_any 'Add service principal credentials' /
//     'Certificates and secrets management').
// ---------------------------------------------------------------------
let credential_add_ops = dynamic([
    "Add service principal credentials",
    "Update application - Certificates and secrets management",
    "Update application – Certificates and secrets management",  // variante con guion largo (en-dash) = forma real del portal
    "Update application",
    "Update service principal"
]);
AuditLogs
| where OperationName in (credential_add_ops)
| extend InitiatedByUser = tostring(InitiatedBy.user.userPrincipalName)
| extend InitiatedById   = tostring(InitiatedBy.user.id)
| extend InitiatedByIp   = tostring(InitiatedBy.user.ipAddress)
// el iniciador es un usuario interactivo (owner), no el pipeline/MS que gestiona la app
| where isnotempty(InitiatedByUser)
// --- enriquecimiento (NO filtro): objeto afectado + indicio de material de credencial ---
| extend TargetObjectType = tostring(TargetResources[0].type)      // 'Application' o 'ServicePrincipal'
| extend TargetObjectName = tostring(TargetResources[0].displayName)
| extend TargetObjectId   = tostring(TargetResources[0].id)
| extend ModifiedProps    = TargetResources[0].modifiedProperties
// 'KeyDescription' es el displayName REAL de la modifiedProperty que porta el
// material de credencial en Entra AuditLogs; 'KeyCredentials'/'PasswordCredentials'
// quedan como fallback defensivo. Es una pista (string search sobre el blob) que
// NO descarta la fila: la rama 'Add service principal credentials' se conserva
// aunque no exponga esa propiedad.
| extend CredMaterialPresent = tostring(ModifiedProps) has_any ("KeyDescription", "KeyCredentials", "PasswordCredentials")
| project
    TimeGenerated,
    Etapa      = "2-credencial anadida (T1098.001)",
    OperationName,
    InitiatedByUser,
    InitiatedById,
    InitiatedByIp,
    TargetObjectType,
    TargetObjectName,
    TargetObjectId,
    CredMaterialPresent,
    ModifiedProps,
    Result,
    CorrelationId
| sort by TimeGenerated desc


// =====================================================================
// Consultas de apoyo (ejecutar por separado). Cada bloque = una etapa.
// =====================================================================

// ---------------------------------------------------------------------
// [B] PRECONDICION / ETAPA 0 - admin-consent del app role peligroso
//     "Add app role assignment to service principal" == concesion de un
//     permiso de APLICACION de Graph al SP. Alerta si el appRoleId es
//     tier-0 (garantiza o facilita escalada a Global Admin).
//     T1098.003 / precondicion de AP04.
// ---------------------------------------------------------------------
// let tier0_app_roles = dynamic([
//     "9e3f62cf-ca93-4989-b6ce-bf83c28f9fe8",   // RoleManagement.ReadWrite.Directory (-> GA garantizado)
//     "06b708a9-e830-4db3-a914-8e69da51d44f",   // AppRoleAssignment.ReadWrite.All     (-> GA garantizado)
//     "1bfefb4e-e0b5-418b-a88f-73c46d2cc8e9"    // Application.ReadWrite.All           (persistencia de creds)
// ]);
