//     | where TimeGenerated > ago(lookback)
//     | where EventID == 4768
//     | extend PreAuthType    = extract(@'Name="PreAuthType">\s*([^<]*?)\s*<', 1, EventData)
//     | extend CertThumbprint = extract(@'Name="CertThumbprint">\s*([^<]*?)\s*<', 1, EventData)
//     | where PreAuthType == "16" or isnotempty(CertThumbprint)
//     | extend PkinitSam = tolower(trim_end(@"\$", tostring(TargetUserName)))
//     | project PkinitTime = TimeGenerated, Host = Computer, PkinitUser = TargetUserName,
//               PkinitSam, PkinitIp = ClientAddress, CertThumbprint;
// issued_esc1
// | join kind=inner pkinit_tgt on Host
// | where PkinitTime between (IssueTime .. (IssueTime + corr_window))
// | where PkinitSam != EnrolleeSam
// | project IssueTime, Enrollee, PkinitTime, PkinitUser, PkinitIp, CertThumbprint,
//           Alert = "AP05 ESC1: low-priv issuance over honeytemplate -> PKINIT as a different account (forged DA)"
// | sort by IssueTime asc


// ---------------------------------------------------------------------
// SUPPLEMENT (outside SecurityEvent) — KB5014754 strong certificate mapping.
// After the patch, if the requester's SID (szOID_NTDS_CA_SECURITY_EXT) does NOT
// match the subject's SID, the KDC writes to the SYSTEM channel (provider
// Microsoft-Windows-Kerberos-Key-Distribution-Center):
//    39  — the KDC found a valid certificate but the SID does not match
//    41  — the certificate and the user's SID do not match (strong mapping)
// These are NOT in SecurityEvent (they belong to the System log). If the DCR also collects
// "System!*[System[(EventID=39 or EventID=41)]]" they land in the Event /
// WindowsEvent table. HIGH-fidelity signal of the ESC1 forge even when Full
// Enforcement ALREADY blocks the logon (the Detect leg fires even if Exploit fails).
// ---------------------------------------------------------------------
// Event
// | where Source has "Kerberos-Key-Distribution-Center" and EventID in (39, 41)
// | sort by TimeGenerated asc
