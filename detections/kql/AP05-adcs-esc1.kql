// =====================================================================
// AP05 — AD CS ESC1 (Enrollee-Supplies-Subject) on a hybrid DC
//        Chain: a LOW-privilege user (AETHER\ap05user) enrolls the
//        honeytemplate 'AetherAuthESC1' specifying SAN = UPN of a Domain
//        Admin  ->  authenticates that certificate via PKINIT  ->  obtains a TGT
//        as the DA  ->  DCSync.
//
// Source: Windows SECURITY events from the DC/CA (on-prem in Azure IaaS),
//         ingested into Log Analytics / Sentinel via Azure Monitor Agent (AMA)
//         + Data Collection Rule.  Table: SecurityEvent.
//         AP05 is on-prem: there are NO Entra cloud logs (AuditLogs/SigninLogs).
//
// MITRE:  T1649     (Steal or Forge Authentication Certificates: ADCS) [CORE]
//         T1550     (Use Alternate Authentication Material: PKINIT with the forged cert)
//         T1003.006 (OS Credential Dumping: DCSync — final objective of the chain)
//
// EVENTS (Windows Security):
//   4886  Certificate Services received a certificate request
//   4887  Certificate Services approved a request and ISSUED a certificate
//   4899  A Certificate Services template was UPDATED
//   4900  The SECURITY of a Certificate Services template was updated
//   4768  A Kerberos TGT was requested (via PKINIT it carries Certificate Information)
//
// AUDIT PREREQUISITE  (enabled by the BASE DSC, not the seed, so it
// persists across seed/-Remediate cycles; WITHOUT it the events are NOT generated and
// the detection fires empty):
//   CA  : certutil -setreg CA\AuditFilter 127 ; Restart-Service certsvc
//         auditpol /set /subcategory:"Certification Services" /success:enable /failure:enable
//   KDC : auditpol /set /subcategory:"Kerberos Authentication Service" /success:enable
//
// CAVEATS OF THE REAL SecurityEvent SCHEMA (verified against the Azure Monitor
// table reference):
//   * The TEMPLATE name of 4886/4887 is NOT a dedicated column: on builds
//     < Windows Server 2025 it travels inside the 'Attributes' column (line
//     "CertificateTemplate:<cn|oid>"); WS2025 adds its own rendered field.
//     It is searched in 'Attributes' and, as a fallback, in the raw XML of 'EventData'.
//   * The forged SAN (DA's UPN) does NOT travel reliably in 4886/4887: it lives in the CA DB
//     (certutil -view / -db). That is why the rule does NOT require requester!=SAN as a gate;
//     enrolling the honeytemplate IS suspicious in itself (AP04 lesson: correlate
//     with OR, never a global AND that silently discards a branch).
//   * SecurityEvent does NOT promote to a column CertThumbprint / CertSerialNumber /
//     CertIssuerName / PreAuthType (those columns are from AADDomainServicesAccountLogon,
//     NOT from SecurityEvent): in 4768 they are EXTRACTED from the XML of 'EventData'.
//   * 4768 is HIGH VOLUME (every TGT in the domain) -> it is narrowed to PKINIT
//     (PreAuthType = 16, PA-PK-AS-REQ / Certificate Information populated) to
//     limit noise and ingestion cost.
//
// SUPPLEMENT: Microsoft Defender for Identity brings native ESC1 detection
//             (certificate forge / suspicious request). Use in parallel.
//
// Author: AETHER   Date: 2026-11-14
// =====================================================================

let esc1_template = "AetherAuthESC1";   // = var.esc1_template_name  (output ap05_esc1_template_name)
let lookback      = 1d;
let corr_window   = 10m;                // window issuance(4887) -> PKINIT(4768) for OUTPUT 2

// ---------------------------------------------------------------------
// SIGNAL A — T1649: request (4886) and ISSUANCE (4887) of a certificate over
//           the ESC1 honeytemplate. Enrolling 'AetherAuthESC1' should NEVER occur
//           in normal operation -> every hit is suspicious on its own.
//           'Requester' = requesting account (expected: AETHER\ap05user, low-priv).
//           'Subject'   = subject DN (the SAN = UPN of the DA does NOT travel reliably here).
// ---------------------------------------------------------------------
let SignalA_enroll =
    SecurityEvent
    | where TimeGenerated > ago(lookback)
    | where EventID in (4886, 4887)
    | where Attributes has esc1_template or EventData has esc1_template
    | project TimeGenerated,
              Signal   = "A-enroll-esc1",
              Stage    = iff(EventID == 4887,
                             "T1649 — cert ISSUED over ESC1 honeytemplate (4887)",
                             "T1649 — cert request over ESC1 honeytemplate (4886)"),
              EventID,
              Actor    = Requester,
              Host     = Computer,
              RequestId,
              Subject,
              Attributes,
              Disposition;

// ---------------------------------------------------------------------
// SIGNAL B — seeding / template tampering: 4899 (template
//           updated) + 4900 (template security updated). The very
//           seeding of 'AetherAuthESC1' by seed-ap05 generates these events: the
//           defender SEES the vuln being planted (teaching point). It also fires with
//           remediation (-Remediate clears the flags / unpublishes).
//           'SubjectUserName' = account that modified the template (expected: EA).
// ---------------------------------------------------------------------
let SignalB_tmplchange =
    SecurityEvent
    | where TimeGenerated > ago(lookback)
    | where EventID in (4899, 4900)
    | project TimeGenerated,
              Signal   = "B-template-change",
              Stage    = iff(EventID == 4900,
                             "T1649 — AD CS template SECURITY modified (4900)",
                             "T1649 — AD CS template updated (4899)"),
              EventID,
              Actor    = SubjectUserName,
              Host     = Computer,
              Attributes,
              EventData;

// ---------------------------------------------------------------------
// SIGNAL C — T1550: Kerberos TGT (4768) issued via PKINIT = authentication with
//           the forged certificate. SecurityEvent does not promote the Certificate
//           Information fields -> they are extracted from the XML of 'EventData'.
//           PKINIT  =>  PreAuthType 16 (PA-PK-AS-REQ)  AND/OR  CertThumbprint /
//           CertSerialNumber non-empty. Filtered with OR (not AND) so the branch is
//           not lost if the pipeline fails to serialize one of the fields.
//           NOTE: if your DCR/AMA serializes EventData differently, adjust the
//           regex against a real 4768 PKINIT event from the DC.
// ---------------------------------------------------------------------
let SignalC_pkinit =
    SecurityEvent
    | where TimeGenerated > ago(lookback)
    | where EventID == 4768
    | extend PreAuthType    = extract(@'Name="PreAuthType">\s*([^<]*?)\s*<', 1, EventData)
    | extend CertThumbprint = extract(@'Name="CertThumbprint">\s*([^<]*?)\s*<', 1, EventData)
    | extend CertSerial     = extract(@'Name="CertSerialNumber">\s*([^<]*?)\s*<', 1, EventData)
    | extend CertIssuer     = extract(@'Name="CertIssuerName">\s*([^<]*?)\s*<', 1, EventData)
    | where PreAuthType == "16" or isnotempty(CertThumbprint)
    | project TimeGenerated,
              Signal   = "C-pkinit-tgt",
              Stage    = "T1550 — TGT via PKINIT (auth with the forged cert)",
              EventID,
              Actor    = TargetUserName,
              Host     = Computer,
              SourceIp = ClientAddress,
              ServiceName,
              PreAuthType,
              CertThumbprint,
              CertSerial,
              CertIssuer,
              Status;

// =====================================================================
// OUTPUT 1 — Unified timeline of the 3 AP05 signals (independent).
// Triage of the full chain (exploit):
//   SIGNAL B (template seeding)  ->  SIGNAL A (4887: issuance over ESC1
//   by the low-priv enrollee)  ->  SIGNAL C (4768 PKINIT for a DIFFERENT
//   privileged account = the forged DA).  Each signal fires ON ITS OWN (union, not AND).
// =====================================================================
union isfuzzy=true SignalA_enroll, SignalB_tmplchange, SignalC_pkinit
| sort by TimeGenerated asc


// =====================================================================
// OUTPUT 2 (high fidelity) — Correlate issuance -> PKINIT.
// 4887 over the ESC1 honeytemplate (low-priv enrollee)  ==>  within
// corr_window, a 4768 PKINIT whose TargetUserName is DIFFERENT from the enrollee
// (= the DA impersonated via the forged SAN). The fingerprint of the issued cert does NOT
// travel in 4887 (only SubjectKeyIdentifier), so the correlation is TEMPORAL + by
// host + account divergence, NOT a join by thumbprint (the fingerprint is only
// in the CA DB). Near-zero FP: it is exactly the pivot that remediation (-Remediate /
// removing ENROLLEE_SUPPLIES_SUBJECT) makes impossible. Uncomment to alert.
// =====================================================================
// let issued_esc1 =
