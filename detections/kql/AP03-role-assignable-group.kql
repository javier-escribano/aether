// =====================================================================
// AP03 — Owner de bajo privilegio sobre grupo ROLE-ASSIGNABLE que porta
//        el rol de directorio 'Privileged Role Administrator' (PRA).
//        Cadena: ownership del grupo -> el owner se AUTO-ANADE a la
//        membership (por defecto en Entra solo GA, PRA y los OWNERS
//        pueden tocar la membership de un grupo role-assignable) ->
//        hereda PRA (asignado AL GRUPO) -> se auto-asigna Global
//        Administrator = toma del tenant.
//
// Fuente: Entra ID Audit Logs (tabla AuditLogs en Sentinel / Defender XDR)
//
// MITRE: T1098     (Account Manipulation: el owner manipula su propia
//                   cuenta auto-anadiendose como miembro del grupo que posee)
//        T1098.003 (Additional Cloud Roles: hereda el rol de directorio
//                   Privileged Role Administrator por la pertenencia al grupo)
//        T1078.004 (Valid Accounts: Cloud Accounts — ejerce PRA para
//                   auto-asignarse Global Administrator)
//        NOTA: el tentativo 'T1484.003' del catalogo NO existe en ATT&CK
//        (T1484 solo tiene .001 Group Policy Modification y .002 Trust
//        Modification); sustituido por el set validado de arriba.
//
// CAVEAT: AuditLogs no expone directamente isAssignableToRole del grupo.
// Se ancla el grupo por nombre/objectId conocido del lab (role_group_name /
// role_group_id) y, para cobertura generica, por su rol portado. La herencia
// de PRA al entrar en el grupo NO genera un evento propio: la senal
// observable es el 'Add member to group' (self-add) y, aguas arriba/abajo,
// la asignacion de rol al grupo y el self-grant final de Global Admin.
//
// Autor: Caelum Range   Fecha: 2026-11-14
// =====================================================================

let lab_prefix      = "caelum";                               // = var.lab_prefix
let role_group_name = strcat(lab_prefix, "-ap03-role-admins");// grupo role-assignable (botin: porta PRA)
let role_group_id   = "";                                     // opcional: objectId del grupo (ap03_group_object_id) para alta fidelidad
let priv_roles      = dynamic([                              // roles de directorio Tier-0 relevantes a la cadena
      "Privileged Role Administrator",                       // rol que porta el grupo (template e8611ab8-c189-46e8-94e1-60213ab1f814)
      "Global Administrator",                                // botin final que PRA se auto-concede
      "Privileged Authentication Administrator"]);
let lookback        = 1d;
let corr_window     = 30m;

// Nota: en 'Add member to group' / 'Add owner to group' el miembro/owner es
// el TargetResource y el grupo viaja en los modifiedProperties del target
// (Group.DisplayName / Group.ObjectID) — se extrae con mv-apply mas abajo.
// ---------------------------------------------------------------------
// SENAL A — Etapa 3 (T1098): el OWNER de bajo privilegio se AUTO-ANADE a
//           la membership del grupo role-assignable privilegiado.
//   OperationName: 'Add member to group'
//   Clave de alta fidelidad: InitiatedBy.user == el usuario anadido
//   (self-add). Un low-priv solo puede hacerlo si es OWNER del grupo.
// ---------------------------------------------------------------------
let SignalA_selfadd =
    AuditLogs
    | where TimeGenerated > ago(lookback)
    | where OperationName == "Add member to group"
    | where Result =~ "success"
    | extend InitId   = tostring(InitiatedBy.user.id)
    | extend InitUpn  = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName))
    | extend InitIp   = tostring(InitiatedBy.user.ipAddress)
    | extend MemberId = tostring(TargetResources[0].id)
    | extend MemberUpn= tostring(TargetResources[0].userPrincipalName)
    // El grupo afectado viaja en los modifiedProperties del target.
    | mv-apply Prop = TargetResources[0].modifiedProperties on (
          summarize GroupName = take_anyif(trim('"', tostring(Prop.newValue)), tostring(Prop.displayName) == "Group.DisplayName"),
                    GroupId   = take_anyif(trim('"', tostring(Prop.newValue)), tostring(Prop.displayName) == "Group.ObjectID")
      )
    // Filtro al grupo objetivo (por nombre y, si se configura, por objectId).
    | where GroupName =~ role_group_name or (isnotempty(role_group_id) and GroupId =~ role_group_id)
    // SELF-ADD: el iniciador es exactamente el miembro anadido.
    | extend IsSelfAdd = (isnotempty(InitId) and InitId =~ MemberId)
    | project TimeGenerated,
              Signal = "A-self-add",
              Stage  = iff(IsSelfAdd, "T1098 — owner self-add a grupo role-assignable", "T1098 — alta de miembro en grupo role-assignable"),
              OperationName,
              Initiator = InitUpn, InitiatorId = InitId, InitiatorIp = InitIp,
              Member = MemberUpn, MemberId,
              GroupName, GroupId,
              IsSelfAdd,
              Result;

// ---------------------------------------------------------------------
// SENAL B — Precondicion / persistencia (T1098): alta de un OWNER sobre el
//           grupo role-assignable. Es el eslabon mal configurado (delegar
//           ownership a un low-priv) y tambien una via de persistencia.
//   OperationName: 'Add owner to group'
// ---------------------------------------------------------------------
let SignalB_addowner =
    AuditLogs
    | where TimeGenerated > ago(lookback)
    | where OperationName == "Add owner to group"
    | where Result =~ "success"
    | extend InitUpn  = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName))
    | extend InitIp   = tostring(InitiatedBy.user.ipAddress)
    | extend NewOwnerId  = tostring(TargetResources[0].id)
    | extend NewOwnerUpn = tostring(TargetResources[0].userPrincipalName)
    | mv-apply Prop = TargetResources[0].modifiedProperties on (
          summarize GroupName = take_anyif(trim('"', tostring(Prop.newValue)), tostring(Prop.displayName) == "Group.DisplayName"),
                    GroupId   = take_anyif(trim('"', tostring(Prop.newValue)), tostring(Prop.displayName) == "Group.ObjectID")
      )
    | where GroupName =~ role_group_name or (isnotempty(role_group_id) and GroupId =~ role_group_id)
    | project TimeGenerated,
              Signal = "B-add-owner",
              Stage  = "T1098 — owner delegado sobre grupo role-assignable (precondicion/persistencia)",
              OperationName,
              Initiator = InitUpn, InitiatorIp = InitIp,
              Member = NewOwnerUpn, MemberId = NewOwnerId,
              GroupName, GroupId,
              IsSelfAdd = false,
              Result;

// ---------------------------------------------------------------------
// SENAL C — Etapas 2/5 (T1098.003 / T1078.004): asignacion de un ROL de
//           directorio privilegiado. Cubre (a) la asignacion de PRA AL
//           GRUPO (provisioning del lab / botin heredado) y (b) el
//           self-grant final de Global Administrator que ejerce el PRA.
//   OperationName: 'Add member to role' / 'Add eligible member to role' /
//                  'Add member to role in PIM requested (permanent)'
// ---------------------------------------------------------------------
let SignalC_roleassign =
    AuditLogs
    | where TimeGenerated > ago(lookback)
    | where OperationName in (
          "Add member to role",
          "Add eligible member to role",
          "Add member to role in PIM requested (permanent)",
          "Add member to role in PIM completed (permanent)")
    | where Result =~ "success"
    | extend InitUpn  = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName))
    | extend InitId   = tostring(InitiatedBy.user.id)
    | extend InitIp   = tostring(InitiatedBy.user.ipAddress)
    | extend PrincipalId  = tostring(TargetResources[0].id)        // usuario O grupo al que se asigna el rol
    | extend PrincipalUpn = coalesce(tostring(TargetResources[0].userPrincipalName), tostring(TargetResources[0].displayName))
    | extend PrincipalType= tostring(TargetResources[0].type)
    | mv-apply Prop = TargetResources[0].modifiedProperties on (
          summarize RoleName = take_anyif(trim('"', tostring(Prop.newValue)), tostring(Prop.displayName) == "Role.DisplayName")
      )
    | where RoleName in (priv_roles)
    | project TimeGenerated,
              Signal = "C-role-assign",
              Stage  = case(
                  RoleName =~ "Global Administrator",         "T1078.004 — self-grant de Global Administrator (ejerciendo PRA)",
                  PrincipalType =~ "Group",                   "T1098.003 — rol privilegiado asignado a GRUPO (herencia por pertenencia)",
                                                              "T1098.003 — rol privilegiado asignado a principal"),
              OperationName,
              Initiator = InitUpn, InitiatorId = InitId, InitiatorIp = InitIp,
              Member = PrincipalUpn, MemberId = PrincipalId,
              GroupName = RoleName, GroupId = PrincipalType,   // reutiliza columnas para union homogenea
              IsSelfAdd = (isnotempty(InitId) and InitId =~ PrincipalId),
              Result;

// =====================================================================
// SALIDA 1 — Timeline unificado de todas las senales AP03.
// Triage: una fila SENAL A con IsSelfAdd==true sobre el grupo role-admins,
// precedida por SENAL C (PRA asignado al grupo) y seguida por SENAL C
// (Global Administrator) del MISMO principal = cadena AP03 completa.
// =====================================================================
union isfuzzy=true SignalA_selfadd, SignalB_addowner, SignalC_roleassign
| sort by TimeGenerated asc

// =====================================================================
// SALIDA 2 (alta fidelidad) — Correlacion self-add (SENAL A) seguido en
// corr_window de un self-grant de rol privilegiado (SENAL C) por el MISMO
// principal. Es exactamente el pivote que la remediacion (no delegar
// ownership de grupos role-assignable a low-priv) debe hacer imposible.
// Casi cero falsos positivos. Descomentar para usar como regla de alerta.
// =====================================================================
// SignalA_selfadd
// | where IsSelfAdd                                   // solo auto-adiciones
// | project AddTime = TimeGenerated, Principal = InitiatorId, PrincipalUpn = Initiator, AddIp = InitiatorIp, GroupName
// | join kind=inner (
//     SignalC_roleassign
//     | project RoleTime = TimeGenerated, Principal = InitiatorId, RoleName = GroupName, RoleIp = InitiatorIp, StageC = Stage
//   ) on Principal
// | where RoleTime between (AddTime .. (AddTime + corr_window))
// | project Principal, PrincipalUpn, AddTime, GroupName, RoleTime, RoleName, StageC, AddIp, RoleIp
// | sort by RoleTime asc
