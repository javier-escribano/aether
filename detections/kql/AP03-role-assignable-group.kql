// =====================================================================
// AP03 — Low-privilege Owner over a ROLE-ASSIGNABLE group that carries
//        the directory role 'Privileged Role Administrator' (PRA).
//        Chain: group ownership -> the owner SELF-ADDS to the
//        membership (by default in Entra only GA, PRA and the OWNERS
//        can touch the membership of a role-assignable group) ->
//        inherits PRA (assigned TO THE GROUP) -> self-assigns Global
//        Administrator = tenant takeover.
//
// Source: Entra ID Audit Logs (AuditLogs table in Sentinel / Defender XDR)
//
// MITRE: T1098     (Account Manipulation: the owner manipulates their own
//                   account by self-adding as a member of the group they own)
//        T1098.003 (Additional Cloud Roles: inherits the directory role
//                   Privileged Role Administrator through group membership)
//        T1078.004 (Valid Accounts: Cloud Accounts — exercises PRA to
//                   self-assign Global Administrator)
//        NOTE: the tentative 'T1484.003' from the catalog does NOT exist in ATT&CK
//        (T1484 only has .001 Group Policy Modification and .002 Trust
//        Modification); replaced by the validated set above.
//
// CAVEAT: AuditLogs does not directly expose the group's isAssignableToRole.
// The group is anchored by its known lab name/objectId (role_group_name /
// role_group_id) and, for generic coverage, by the role it carries. Inheriting
// PRA on joining the group does NOT generate its own event: the observable
// signal is the 'Add member to group' (self-add) and, upstream/downstream,
// the role assignment to the group and the final self-grant of Global Admin.
//
// Author: Azure Attack Range   Date: 2026-11-14
// =====================================================================

let lab_prefix      = "azrange";                             // = var.lab_prefix
let role_group_name = strcat(lab_prefix, "-ap03-role-admins");// role-assignable group (loot: carries PRA)
let role_group_id   = "";                                     // optional: objectId of the group (ap03_group_object_id) for high fidelity
let priv_roles      = dynamic([                              // Tier-0 directory roles relevant to the chain
      "Privileged Role Administrator",                       // role carried by the group (template e8611ab8-c189-46e8-94e1-60213ab1f814)
      "Global Administrator",                                // final loot that PRA self-grants
      "Privileged Authentication Administrator"]);
let lookback        = 1d;
let corr_window     = 30m;

// Note: in 'Add member to group' / 'Add owner to group' the member/owner is
// the TargetResource and the group travels in the modifiedProperties of the
// target (Group.DisplayName / Group.ObjectID) — extracted with mv-apply below.
// ---------------------------------------------------------------------
// SIGNAL A — Stage 3 (T1098): the low-privilege OWNER SELF-ADDS to
//           the membership of the privileged role-assignable group.
//   OperationName: 'Add member to group'
//   High-fidelity key: InitiatedBy.user == the added user
//   (self-add). A low-priv user can only do this if they are OWNER of the group.
// ---------------------------------------------------------------------
let SignalA_selfadd =
    AuditLogs
    | where TimeGenerated > ago(lookback)
    | where OperationName == "Add member to group"
    | where Result =~ "success"
    | extend InitId   = tostring(InitiatedBy.user.id)
    | extend InitUpn  = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName))
    | extend InitIp   = tostring(InitiatedBy.user.ipAddress)
    | extend MemberId = tostring(TargetResources[0].id)
    | extend MemberUpn= tostring(TargetResources[0].userPrincipalName)
    // The affected group travels in the modifiedProperties of the target.
    | mv-apply Prop = TargetResources[0].modifiedProperties on (
          summarize GroupName = take_anyif(trim('"', tostring(Prop.newValue)), tostring(Prop.displayName) == "Group.DisplayName"),
                    GroupId   = take_anyif(trim('"', tostring(Prop.newValue)), tostring(Prop.displayName) == "Group.ObjectID")
      )
    // Filter to the target group (by name and, if configured, by objectId).
    | where GroupName =~ role_group_name or (isnotempty(role_group_id) and GroupId =~ role_group_id)
    // SELF-ADD: the initiator is exactly the added member.
    | extend IsSelfAdd = (isnotempty(InitId) and InitId =~ MemberId)
    | project TimeGenerated,
              Signal = "A-self-add",
              Stage  = iff(IsSelfAdd, "T1098 — owner self-add to role-assignable group", "T1098 — member added to role-assignable group"),
              OperationName,
              Initiator = InitUpn, InitiatorId = InitId, InitiatorIp = InitIp,
              Member = MemberUpn, MemberId,
              GroupName, GroupId,
              IsSelfAdd,
              Result;

// ---------------------------------------------------------------------
// SIGNAL B — Precondition / persistence (T1098): adding an OWNER to the
//           role-assignable group. This is the misconfigured link (delegating
//           ownership to a low-priv) and also a persistence avenue.
//   OperationName: 'Add owner to group'
// ---------------------------------------------------------------------
let SignalB_addowner =
    AuditLogs
    | where TimeGenerated > ago(lookback)
    | where OperationName == "Add owner to group"
    | where Result =~ "success"
    | extend InitUpn  = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName))
    | extend InitIp   = tostring(InitiatedBy.user.ipAddress)
    | extend NewOwnerId  = tostring(TargetResources[0].id)
    | extend NewOwnerUpn = tostring(TargetResources[0].userPrincipalName)
    | mv-apply Prop = TargetResources[0].modifiedProperties on (
          summarize GroupName = take_anyif(trim('"', tostring(Prop.newValue)), tostring(Prop.displayName) == "Group.DisplayName"),
                    GroupId   = take_anyif(trim('"', tostring(Prop.newValue)), tostring(Prop.displayName) == "Group.ObjectID")
      )
    | where GroupName =~ role_group_name or (isnotempty(role_group_id) and GroupId =~ role_group_id)
    | project TimeGenerated,
              Signal = "B-add-owner",
              Stage  = "T1098 — delegated owner over role-assignable group (precondition/persistence)",
              OperationName,
              Initiator = InitUpn, InitiatorIp = InitIp,
              Member = NewOwnerUpn, MemberId = NewOwnerId,
              GroupName, GroupId,
              IsSelfAdd = false,
              Result;

// ---------------------------------------------------------------------
// SIGNAL C — Stages 2/5 (T1098.003 / T1078.004): assignment of a privileged
//           directory ROLE. Covers (a) the assignment of PRA TO THE
//           GROUP (lab provisioning / inherited loot) and (b) the
//           final self-grant of Global Administrator exercised by PRA.
//   OperationName: 'Add member to role' / 'Add eligible member to role' /
//                  'Add member to role in PIM requested (permanent)'
// ---------------------------------------------------------------------
let SignalC_roleassign =
    AuditLogs
    | where TimeGenerated > ago(lookback)
    | where OperationName in (
          "Add member to role",
          "Add eligible member to role",
          "Add member to role in PIM requested (permanent)",
          "Add member to role in PIM completed (permanent)")
    | where Result =~ "success"
    | extend InitUpn  = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName))
    | extend InitId   = tostring(InitiatedBy.user.id)
    | extend InitIp   = tostring(InitiatedBy.user.ipAddress)
    | extend PrincipalId  = tostring(TargetResources[0].id)        // user OR group the role is assigned to
    | extend PrincipalUpn = coalesce(tostring(TargetResources[0].userPrincipalName), tostring(TargetResources[0].displayName))
    | extend PrincipalType= tostring(TargetResources[0].type)
    | mv-apply Prop = TargetResources[0].modifiedProperties on (
          summarize RoleName = take_anyif(trim('"', tostring(Prop.newValue)), tostring(Prop.displayName) == "Role.DisplayName")
      )
    | where RoleName in (priv_roles)
    | project TimeGenerated,
              Signal = "C-role-assign",
              Stage  = case(
                  RoleName =~ "Global Administrator",         "T1078.004 — self-grant of Global Administrator (exercising PRA)",
                  PrincipalType =~ "Group",                   "T1098.003 — privileged role assigned to a GROUP (inheritance via membership)",
                                                              "T1098.003 — privileged role assigned to a principal"),
              OperationName,
              Initiator = InitUpn, InitiatorId = InitId, InitiatorIp = InitIp,
              Member = PrincipalUpn, MemberId = PrincipalId,
              GroupName = RoleName, GroupId = PrincipalType,   // reuse columns for a homogeneous union
              IsSelfAdd = (isnotempty(InitId) and InitId =~ PrincipalId),
              Result;

// =====================================================================
// OUTPUT 1 — Unified timeline of all AP03 signals.
// Triage: a SIGNAL A row with IsSelfAdd==true over the role-admins group,
// preceded by SIGNAL C (PRA assigned to the group) and followed by SIGNAL C
// (Global Administrator) by the SAME principal = full AP03 chain.
// =====================================================================
union isfuzzy=true SignalA_selfadd, SignalB_addowner, SignalC_roleassign
| sort by TimeGenerated asc

// =====================================================================
// OUTPUT 2 (high fidelity) — Correlate self-add (SIGNAL A) followed within
// corr_window by a self-grant of a privileged role (SIGNAL C) by the SAME
// principal. It is exactly the pivot that remediation (not delegating
// ownership of role-assignable groups to low-priv) must make impossible.
// Near-zero false positives. Uncomment to use as an alert rule.
// =====================================================================
// SignalA_selfadd
// | where IsSelfAdd                                   // only self-adds
// | project AddTime = TimeGenerated, Principal = InitiatorId, PrincipalUpn = Initiator, AddIp = InitiatorIp, GroupName
// | join kind=inner (
//     SignalC_roleassign
//     | project RoleTime = TimeGenerated, Principal = InitiatorId, RoleName = GroupName, RoleIp = InitiatorIp, StageC = Stage
//   ) on Principal
// | where RoleTime between (AddTime .. (AddTime + corr_window))
// | project Principal, PrincipalUpn, AddTime, GroupName, RoleTime, RoleName, StageC, AddIp, RoleIp
// | sort by RoleTime asc
