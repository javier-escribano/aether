// ---------------------------------------------------------------------
// COMPLEMENT (management plane, high fidelity) - ANY roleAssignments/write whose Caller
// is an Automation MI = escalation by an automation deputy. A role assignment executed
// BY an Automation Account identity is, on its own, extremely high signal (no automation
// should hand out RBAC). Fill automation_mi_oids with the objectIds of your Automation
// Accounts' MIs (output ap08_mi_principal_id for the lab's) and alert. Independent of the RG and the
// runbook: it catches the primitive across the whole subscription. Uncomment.
// ---------------------------------------------------------------------
// let automation_mi_oids = dynamic([]);   // objectIds of system-assigned MIs of Automation Accounts
// AzureActivity
// | where TimeGenerated > ago(lookback)
// | where OperationNameValue =~ "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE"
// | where ActivityStatusValue in~ ("Success", "Accept", "Start")
// | where Caller in~ (automation_mi_oids)
// | project TimeGenerated, Caller, CallerIpAddress, ResourceGroup, _ResourceId,
//           Alert = "AP08: roleAssignments/write executed by the MI of an Automation Account (RBAC escalation via runbook)"
// | sort by TimeGenerated asc
