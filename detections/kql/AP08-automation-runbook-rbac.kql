//     | where mi_principal_id == "" or Caller =~ mi_principal_id    // the grant is executed by the MI (GOLDEN SIGNAL)
//     | extend GrantBeneficiaryHint = tolower(extract(@'(?i)principalid"?\s*[:=]\s*"?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})', 1, tostring(Properties)))
//     | project GrantTime = TimeGenerated, Grantor = Caller, GrantorIp = CallerIpAddress,
//               ResourceGroup, GrantResourceId = _ResourceId, GrantBeneficiaryHint;
// let stream_benef =
//     AzureDiagnostics
//     | where TimeGenerated > ago(lookback)
//     | where ResourceProvider == "MICROSOFT.AUTOMATION" and Category == "JobStreams"
