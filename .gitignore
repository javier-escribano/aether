# === Terraform ===
# NEVER commit state or secrets: they contain range credentials in cleartext.
*.tfstate
*.tfstate.*
.terraform/
# .terraform.lock.hcl is intentionally COMMITTED: it pins provider versions + hashes
# (supply-chain integrity) and holds no secrets.
crash.log
crash.*.log

# Terraform plan files (a saved plan embeds state + secrets in cleartext)
*.tfplan
tfplan
*.plan

# AP05 DSC package artifact (archive_file regenerates it on each plan/apply).
AetherDC.zip
.dsc-build/

# Real variables (only the .example is versioned)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# === Secrets / credentials ===
*.pem
*.key
*.pfx
*.p12
*.publishsettings
azureauth.json
sp-credentials.json
.env
.env.*

# SSH private keys (in case an operator adds their own to reach a VM)
id_rsa*
id_ed25519*
*_rsa

# Cloud CLI token caches / registry credentials
.azure/
msal_token_cache.*
.terraformrc
terraform.rc

# DSC compiled artifacts (localhost.mof may embed plaintext credentials)
*.mof

# === PowerShell / script output ===
*.clixml
seed-output-*.json
verify-report-*.json

# === System ===
.DS_Store
Thumbs.db
*.log
