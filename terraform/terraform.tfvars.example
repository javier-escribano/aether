# Copy to terraform.tfvars and edit. terraform.tfvars is in .gitignore (not versioned).

tenant_domain = "azrangelab.onmicrosoft.com"   # <-- YOUR TEST tenant

# Safety pin: Terraform refuses to deploy anywhere else, and azrange.ps1 verifies
# the active az session matches. Find them with:
#   az account show --query '{tenant:tenantId, sub:id}' -o json
expected_tenant_id = "00000000-0000-0000-0000-000000000000" # <-- YOUR TEST tenant id (GUID), REQUIRED
# expected_subscription_id = "00000000-0000-0000-0000-000000000000"  # <-- TEST subscription id; leave commented for identity-only (AP01/03/04)

lab_prefix = "azrange"
user_count = 5

# Azure region for AP02/AP05/AP07/AP08 (only used if enable_ap02, enable_ap05, enable_ap07, or enable_ap08):
location = "westeurope"

# Cost controls (optional):
# auto_shutdown_time     = "2200"                      # HHmm, when the VMs auto-deallocate
# auto_shutdown_timezone = "W. Europe Standard Time"   # set YOUR timezone (Windows tz id)
# law_daily_cap_gb       = 0.5                          # daily ingestion cap on the lab's Log Analytics
# budget_monthly_amount  = 20                           # optional Cost Management budget + email alerts
# budget_alert_emails    = ["you@example.com"]          # required if budget_monthly_amount is set

# --- Active attack paths ---
# Recommended for the first deployment: only AP01 (identity, no cost).
enable_ap01 = true

# AP02 deploys VM + Key Vault + storage: BILLS compute.
# Enable it only in a test tenant/subscription and run `azrange.ps1 destroy` when done.
enable_ap02 = false
# AP02 SSH is open to the Internet by design (initial-access lesson). To lock it to you:
# ap02_ssh_source_cidr = "203.0.113.10/32"

# AP03 (identity): low-privilege owner over a role-assignable group → PRA → Global Admin.
# Cost ~$0 but REQUIRES Entra ID P1 (role-assignable groups), NOT pure Entra Free.
# The principal running `apply` must have Privileged Role Administrator or Global Administrator.
enable_ap03 = false

# AP04 (identity): low-privilege owner over an app registration whose SP carries RoleManagement.ReadWrite.Directory
# (admin-consented). The owner adds a client secret → app-only SP token → self-assigns Global Admin.
# Cost ~$0 (Entra Free). The principal running `apply` must have Global Administrator or Privileged Role Administrator
# to grant the admin-consent for the Graph application permission.
enable_ap04 = false

# AP05 (hybrid): AD CS ESC1 over a Windows Server 2022 DC on Azure IaaS.
# COST WARNING! It's the MOST EXPENSIVE AP: a Windows VM powered on 24/7 (mitigated by
# daily auto-shutdown). Enable it only in a test subscription and run
# `./azrange.ps1 destroy` (or enable_ap05=false) when done.
enable_ap05 = false

# AP06 (hybrid): Entra Connect / Seamless SSO (AZUREADSSOACC$). On-prem→cloud
# bridge, 2nd hybrid path and the one that CLOSES the catalog. REUSES the AP05 DC
# (shared substrate via need_dc): if enable_ap05=true, AP06 does NOT add a
# VM; if AP05 is off, AP06 brings up the DC on its own (BILLS COMPUTE like AP05).
# Secrets (sso/sync/EA) LAND IN STATE (sensitive, like dc_admin_password).
# reset = enable_ap06=false (+ enable_ap05=false to destroy the DC). Fix
# in-place (AP06-off with AP05-on, the DC survives): seed-ap06.ps1 -Remediate.
enable_ap06 = false

# Artifacts to seed (only relevant if enable_ap06 = true):
#   "both"          → full chain sync→DCSync→AZUREADSSOACC$→silver ticket→cloud (default).
#   "silver_ticket" → only AZUREADSSOACC$ with a fixed/non-rotated key + SPNs.
#   "sync_dcsync"   → only the sync account with DCSync ACEs over the NC.
sso_mode = "both"

# Account names (optional; realistic defaults):
# sso_account_name  = "AZUREADSSOACC"
# sync_account_name = "Sync_AZRANGE"

# AP07 (Azure, ~zero cost, NO VM): storage with anonymous access → leaked blob
# with an over-scoped credential → exfil of the private container. It's "the cheap one":
# only storage + a few KB of blobs + minimal log ingestion (cents/month).
# 100% declarative (no seed). reset = enable_ap07=false → atomic destroy.
# WARNING!: the leaked SAS/key LANDS IN Terraform STATE (sensitive,
# like AP05's dc_admin_password). Treat the tfstate as toxic; it's already in
# .gitignore. Enable it only in a TEST subscription.
enable_ap07 = false

# Mode of the leaked credential (only relevant if enable_ap07 = true):
#   "sas"         → over-scoped account SAS (default; least-privilege lesson).
#   "account_key" → primary_access_key (full control, more severe).
leak_mode = "sas"

# AP07 storage firewall: by default the vulnerable account is reachable ONLY from
# admin_source_cidr (your IP) — the anonymous-access lesson works for you, but the
# Internet cannot abuse your subscription. Set admin_source_cidr (AP05 section below)
# even if you only run AP07. Set this true to expose it to everyone on purpose:
# ap07_internet_exposed = false

# AP07 telemetry (StorageBlobLogs via diagnostic setting → Log Analytics).
# true = 'Detect' testable end-to-end (ingestion << 0.1 GB/day). false = no
# ingestion (zero cost; assumes an external SIEM). Reuses
# existing_log_analytics_workspace_id (below) to avoid creating its own LAW.
collect_storage_logs = true

# AP08 (Azure, ~zero cost, NO VM): Automation Account with an over-privileged
# system-assigned MI (UAA/Owner over the RG) + a low-priv attacker (Automation
# Contributor) → a runbook running AS the MI self-grants Owner of the RG.
# 100% declarative (no seed): deploy = apply only. The 'gun' is left loaded
# (published runbook) but Terraform NEVER starts a job; the "exploit"
# (Start-AzAutomationRunbook) is the student's action. reset = enable_ap08=false →
# atomic destroy of the RG (and with it every RG-scoped runtime role assignment).
# WARNING!: the attacker's password LANDS IN STATE (sensitive, like
# AP05's dc_admin_password). Treat the tfstate as toxic; it's already in .gitignore.
# Enable it only in a TEST subscription.
enable_ap08 = false

# Embedded runbook (only relevant if enable_ap08 = true):
#   "poc_escalation" → loaded gun: the runbook grants the attacker Owner of the RG
#                      (immediate demo; default). Risk bounded by RG-scope +
#                      Terraform never fires it.
#   "benign_probe"   → the runbook ONLY tests the MI's identity/power; the student
#                      writes the escalation (safer for shared deployments).
#   "none"           → no embedded runbook; pure misconfig (the student authors everything).
runbook_mode = "poc_escalation"

# Over-priv role of the MI OVER THE RG (only relevant if enable_ap08 = true):
#   "UserAccessAdministrator" → minimum-that-escalates (its only power is assigning
#                               roles; sharpest lesson; default).
#   "Owner"                   → more realistic/common in real tenants.
# (Contributor is NOT enough: it does not include roleAssignments/write.)
mi_role = "UserAccessAdministrator"

# AP08 telemetry (JobLogs + JobStreams via diagnostic setting → Log Analytics,
# AzureDiagnostics table). true = 'Detect' testable end-to-end (minimal ingestion).
# false = no ingestion (zero cost; assumes an external SIEM). These categories are NOT
# active by default → without this setting the runbook EXECUTION does not exist in the
# SIEM (the management plane DOES flow through AzureActivity). Reuses
# existing_log_analytics_workspace_id (below) to avoid creating its own LAW.
collect_automation_logs = true

# --- AP05 config (only used if enable_ap05 = true) ---
# YOUR public /32 IP for RDP/WinRM to the DC. NEVER 0.0.0.0/0 (a DC is not exposed to
# the Internet). Leave it undefined (null) to open no ports (Bastion/serial).
# admin_source_cidr = "203.0.113.10/32"
# Also open WinRM (5985/5986) to that CIDR (default: RDP only; seeding uses run-command).
# expose_winrm = false

# Domain Administrator password (= EA that seeds/remediates ESC1).
# Leave it empty/undefined → the module generates a random_password. NEVER a real password.
# dc_admin_password = null

domain_fqdn = "azrange.lab"

# vm_size = "Standard_B2ms"   # "Standard_B2s" as the cheaper floor.

# Detection telemetry (AMA+DCR+Log Analytics). true = 'Detect' testable
# end-to-end (feed of 1 DC filtered to 5 EventIDs << 0.1-0.3 GB/day). false = no
# ingestion (zero cost; assumes an external SIEM).
collect_security_events = true

# To point the DCR at an EXISTING Sentinel/Log Analytics (and not create one):
# existing_log_analytics_workspace_id = "/subscriptions/.../resourceGroups/.../providers/Microsoft.OperationalInsights/workspaces/..."
